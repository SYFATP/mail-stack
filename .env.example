# Example only: replace domains, public IP and secrets before deployment.
MAIL_DOMAIN=example.com
MAIL_DOMAINS=example.com
MAIL_HOST=mail.example.com
# Existing/initial domains remain fixed-user mode. New API domains default catch-all.
MAILBOX_USERS=test,postmaster,admin
PUBLIC_SERVER_IP=203.0.113.10
CF_API_TOKEN=
CF_API_EMAIL=
CF_API_KEY=
# Configure an actual Argon2id hash. Empty hash/password denies initial login.
# Generate with: python -c "from passlib.hash import argon2; from getpass import getpass; print(argon2.hash(getpass()))"
ADMIN_PASSWORD_HASH=
# Optional initial bootstrap password; remove after setting a stored admin password.
ADMIN_PASSWORD=
API_KEY_PEPPER=replace-with-random-32-byte-value
WEBHOOK_TIMEOUT_SECONDS=10
# Optional exact hostname allowlist. Webhooks always require public HTTPS,
# validate every DNS answer, pin the connection and reject redirects.
WEBHOOK_ALLOWED_HOSTS=
INGEST_INTERVAL_SECONDS=2
WEBHOOK_WORKERS=4
CUR_SCAN_INTERVAL_SECONDS=60
# Applied by Postfix; full API/attachment limits are part of P4.
MAX_MESSAGE_MB=20
# Trusted internal submission only.
SMTP_SUBMISSION_HOST=mail-postfix
SMTP_SUBMISSION_PORT=25
POSTFIX_MYNETWORKS=127.0.0.0/8,172.30.0.10/32
# Optional authenticated outbound SMTP relay. Leave host empty for direct MX delivery.
# Relay requires verified STARTTLS (normally port 587); implicit TLS/465 is unsupported.
MAIL_OUTBOUND_SMTP_HOST=
MAIL_OUTBOUND_SMTP_PORT=587
MAIL_OUTBOUND_SMTP_USERNAME=
MAIL_OUTBOUND_SMTP_PASSWORD=
MAIL_OUTBOUND_SMTP_STARTTLS=1
# Mail-stack submits to the internal Postfix relay first. On an explicit
# pre-acceptance SMTP failure, the API worker may fall back to Brevo's
# transactional API when BREVO_API_KEY is configured. Unknown SMTP outcomes
# are never replayed through the alternate transport.
MAIL_OUTBOUND_API_FALLBACK=1
# Set to 0 when the relay signs with the authenticated sender domain (for
# example Brevo). Direct-MX delivery should keep local DKIM enabled.
MAIL_OUTBOUND_DKIM_ENABLED=1

# Optional Brevo domain-authentication API.  The API key is only read by
# mail-api and is never returned by the control-plane endpoints.
BREVO_API_BASE=https://api.brevo.com
BREVO_API_KEY=
# Set to 1 to automatically register claimed domains in Brevo, include its
# verification code and DKIM records in DNS preview/apply, and authenticate
# the domain after DNS validation.
BREVO_DNS_SYNC_ENABLED=0
# Encrypted provider credentials, including the global Cloudflare configuration.
# Existing plaintext Cloudflare settings migrate at startup; a configured
# keyring is required for that migration and for saving provider credentials.
# Keep keyring separate from DB backups. See docs/security-hardening.md.
# Generate a Fernet key (never commit it):
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MAIL_CREDENTIAL_KEYS={}
MAIL_CREDENTIAL_ACTIVE_KEY=
# Single API process; at most two DNS I/O tasks. No automatic unknown-job replay.
DOMAIN_JOBS_ENABLED=1
# 1 restores serial execution; values above 2 are clamped.
DOMAIN_JOB_CONCURRENCY=2
DNS_CHECK_MAX_AGE_SECONDS=3600
# Local mock provider HTTP is denied unless explicitly enabled for loopback fixtures.
ALLOW_LOCAL_PROVIDER_HTTP=0
